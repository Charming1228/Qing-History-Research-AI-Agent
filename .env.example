# =====================================================================
# 清鉴 · 环境变量示例
# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）。
#   cp .env.example .env
# 启动前加载（Linux/macOS）：
#   set -a && source .env && set +a
# Windows PowerShell：
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
# =====================================================================

# ---- DeepSeek（agent.py / agent2.py / agent4.py 共用）----
DEEPSEEK_API_KEY=sk-请替换为你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# agent4 当前使用 deepseek-v4-flash；agent/agent2 使用 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ---- Moark 中转 API（编年/档案微调数据构建、archive_search.py 使用）----
MOARK_API_KEY=请替换为你的Moark密钥
MOARK_BASE_URL=https://api.moark.com/v1
MOARK_MODEL=DeepSeek-V4-Pro
